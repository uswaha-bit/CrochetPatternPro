# ---------- App ----------
NODE_ENV=development
PORT=3000

# ---------- MongoDB ----------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
DB_LOCAL_URI=mongodb://127.0.0.1:27017/<dbname>

# ---------- Auth (JWT) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWTSECRET=replace_with_a_long_random_string_at_least_32_chars
JWTEXPIRESIN=7d
# Cookie lifetime in days
COOKIEEXPIRESTIME=7

# ---------- Email (Nodemailer) ----------
NODEMAILER_HOST=smtp.example.com
NODEMAILER_PORT=587
NODEMAILER_USER=your_smtp_username
NODEMAILER_PASSWORD=your_smtp_password
NODEMAILER_FROM_EMAIL=noreply@example.com
NODEMAILER_FROM_NAME=Your App Name

# ---------- AWS S3 ----------
AWS_S3_BUCKET_ACCESS_KEY_ID=your_access_key_id
AWS_S3_BUCKET_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_BUCKET_REGION=us-east-1
# Pre-signed URL lifetime in seconds
AWS_S3_PRE_SIGNED_URL_EXPIRE_TIME=300

# ---------- Neo4j ----------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
DATABASE_NAME=neo4j

# ---------- Gemini ----------
GEMINI_API_KEY=your_gemini_api_key